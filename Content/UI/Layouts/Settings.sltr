<?xml version="1.0"?>
<!-- Controls that edit their data (T-381): each control shows a field and writes it back when the user changes it; the muted texts read the same fields, so they follow. With Settings.mock.json the preview tab writes into the mock data. -->
<surface role="UI.Surface.Panel" inset="UI.Space.L" width="360">
	<vbox>
		<text font="UI.Font.Heading">Settings</text>
		<spacer height="UI.Space.L"/>
		<hbox>
			<text fill="1">Volume</text>
			<text color="UI.Color.TextMuted">{Volume}</text>
		</hbox>
		<slider value="{Volume}" on-change="{Volume}" step="0.05"/>
		<spacer height="UI.Space.M"/>
		<hbox>
			<checkbox checked="{Muted}" on-change="{Muted}" fill="1">
				<text margin="UI.Space.S">Mute</text>
			</checkbox>
			<text color="UI.Color.TextMuted">{Muted}</text>
		</hbox>
		<spacer height="UI.Space.M"/>
		<text>Name</text>
		<spacer height="UI.Space.S"/>
		<textbox text="{Name}" on-commit="{Name}" hint="Your name"/>
		<spacer height="UI.Space.S"/>
		<text font="UI.Font.Caption" color="UI.Color.TextMuted">{Name}</text>
	</vbox>
</surface>
