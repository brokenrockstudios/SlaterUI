<?xml version="1.0"?>
<!-- The shipped base style. Other styles extend it and override what differs. -->
<style name="Base">
	<color name="UI.Color.Background" value="#F2F3F5"/>
	<color name="UI.Color.Panel" value="#FFFFFF"/>
	<color name="UI.Color.Border" value="#C9CDD4"/>
	<color name="UI.Color.Text" value="#1D2129"/>
	<color name="UI.Color.TextMuted" value="#6B7280"/>
	<color name="UI.Color.Accent" value="#2F6FEB"/>
	<color name="UI.Color.Accent.Hover" value="#4F86F0"/>
	<color name="UI.Color.Accent.Pressed" value="#1F58C7"/>
	<color name="UI.Color.Danger" value="#D64545"/>
	<!-- The popup menu is dark in every style: its icons are white strokes. -->
	<color name="UI.Color.Menu" value="#262A32"/>
	<color name="UI.Color.Menu.Hover" value="#343944"/>
	<color name="UI.Color.MenuLine" value="#3A3F4A"/>
	<color name="UI.Color.MenuText" value="#E6E8EC"/>
	<color name="UI.Color.MenuMuted" value="#9AA1AD"/>
	<color name="UI.Color.Clear" value="#00000000"/>
	<!-- Cards, inset panels and bars (T-408): flat panels with an outline; Card.Hover swaps the outline to the accent. -->
	<color name="UI.Color.Card" value="#FFFFFF"/>
	<color name="UI.Color.Card.Hover" value="#F7F9FC"/>
	<color name="UI.Color.CardLine" value="#D5DAE1"/>
	<color name="UI.Color.Inset" value="#F2F3F5"/>
	<color name="UI.Color.Track" value="#E1E5EB"/>

	<metric name="UI.Space.S" value="4"/>
	<metric name="UI.Space.M" value="8"/>
	<metric name="UI.Space.L" value="16"/>
	<metric name="UI.Size.SidebarOpen" value="220"/>
	<metric name="UI.Size.SidebarRail" value="60"/>
	<metric name="UI.Radius.M" value="4"/>
	<metric name="UI.Radius.Card" value="6"/>
	<metric name="UI.Border.Thin" value="1"/>

	<font name="UI.Font.Body" role="Regular" size="14"/>
	<font name="UI.Font.Heading" role="Bold" size="20"/>
	<font name="UI.Font.Caption" role="Italic" size="11"/>

	<!-- Motion: how long a transition takes and its ease (T-404). Panel is the sidebar and other slide-open panels. -->
	<motion name="UI.Motion.Panel" duration="0.1" ease="CubicOut"/>

	<surface name="UI.Surface.Background" fill="UI.Color.Background"/>
	<surface name="UI.Surface.Panel" fill="UI.Color.Panel" border="UI.Color.Border" border-width="UI.Border.Thin" radius="UI.Radius.M"/>
	<surface name="UI.Surface.Button" fill="UI.Color.Accent" radius="UI.Radius.M"/>
	<surface name="UI.Surface.Button.Hover" fill="UI.Color.Accent.Hover" radius="UI.Radius.M"/>
	<surface name="UI.Surface.Button.Pressed" fill="UI.Color.Accent.Pressed" radius="UI.Radius.M"/>
	<surface name="UI.Surface.Menu" fill="UI.Color.Menu" border="UI.Color.MenuLine" border-width="UI.Border.Thin" radius="UI.Radius.M"/>
	<surface name="UI.Surface.MenuItem" fill="UI.Color.Clear" radius="UI.Radius.M"/>
	<surface name="UI.Surface.MenuItem.Hover" fill="UI.Color.Menu.Hover" radius="UI.Radius.M"/>
	<surface name="UI.Surface.Divider" fill="UI.Color.MenuLine"/>
	<surface name="UI.Surface.Scrim" fill="UI.Color.Clear"/>
	<surface name="UI.Surface.Card" fill="UI.Color.Card" border="UI.Color.CardLine" border-width="UI.Border.Thin" radius="UI.Radius.Card"/>
	<surface name="UI.Surface.Card.Hover" fill="UI.Color.Card.Hover" border="UI.Color.Accent" border-width="UI.Border.Thin" radius="UI.Radius.Card"/>
	<surface name="UI.Surface.Inset" fill="UI.Color.Inset" border="UI.Color.CardLine" border-width="UI.Border.Thin" radius="UI.Radius.M"/>
	<surface name="UI.Surface.Track" fill="UI.Color.Track" radius="UI.Radius.M"/>
	<surface name="UI.Surface.Fill" fill="UI.Color.Accent" radius="UI.Radius.M"/>
</style>
